{
  "name": "syzzz-code",
  "version": "1.0.0",
  "description": "Syzzz Code - AI Programming Assistant",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syz0528/Syzzz-Code.git"
  },
  "homepage": "https://github.com/syz0528/Syzzz-Code#readme",
  "bugs": {
    "url": "https://github.com/syz0528/Syzzz-Code/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "coding-assistant",
    "mcp"
  ],
  "type": "module",
  "bin": {
    "syzzz": "./dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "CHANGELOG.md",
    "ARCHITECTURE.md",
    "TESTING.md",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "eslint src tests scripts eslint.config.js prettier.config.mjs",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:coverage": "npm run build && node --test --test-concurrency=4 --experimental-test-coverage --test-coverage-include=dist/**/*.js --test-coverage-lines=82 --test-coverage-branches=74 --test-coverage-functions=84 tests/*.test.mjs",
    "test:providers": "npm run build && node --test tests/provider-contracts.test.mjs tests/openai-stream.test.mjs tests/openai-responses.test.mjs tests/anthropic-provider.test.mjs tests/provider-runner.test.mjs",
    "test:tui": "npm run build && node --test tests/phase8-runtime.test.mjs tests/tui.test.mjs",
    "test:context": "npm run build && node --test tests/context-manager.test.mjs tests/context-runtime.test.mjs",
    "test:stability": "npm run build && node scripts/stability-run.mjs",
    "eval:offline": "npm run build && node scripts/eval-runner.mjs --suite offline",
    "eval:live": "npm run build && node scripts/eval-runner.mjs --suite live",
    "eval:rag:offline": "npm run build && node scripts/rag-eval-runner.mjs --suite offline",
    "eval:rag:live": "npm run build && node scripts/rag-eval-runner.mjs --suite live",
    "license:check": "node scripts/license-check.mjs",
    "secret:scan": "node scripts/secret-scan.mjs",
    "pack:check": "npm run build && node scripts/package-check.mjs",
    "smoke:package": "npm run build && node scripts/package-smoke.mjs",
    "smoke:context": "npm run build && node scripts/context-smoke.mjs",
    "check": "npm run format:check && npm run lint && npm test && npm run test:tui && npm run test:coverage && npm run eval:offline && npm run eval:rag:offline && npm run license:check && npm run secret:scan && npm run pack:check",
    "release:publish": "node scripts/publish-package.mjs",
    "release:verify": "npm run check && npm run smoke:package && node scripts/release-verify.mjs",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run release:verify"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@lancedb/lancedb": "0.37.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@vscode/ripgrep": "^1.18.0",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "ink": "^7.1.1",
    "jsonc-parser": "3.3.1",
    "marked": "^18.0.9",
    "minisearch": "7.2.0",
    "openai": "^7.4.0",
    "ora": "^9.4.1",
    "picomatch": "^4.0.5",
    "react": "^19.2.8",
    "string-width": "^8.2.2",
    "typescript": "^7.0.2",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/server": "2.0.0",
    "@types/node": "^22.20.1",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.2.14",
    "@xterm/headless": "^6.0.0",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.7.0",
    "typescript-eslint": "^8.65.0"
  },
  "overrides": {
    "sharp": "0.35.3"
  }
}
