{
  "name": "syzzz-code",
  "version": "1.0.0",
  "description": "Syzzz Code - AI Programming Assistant",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "syzzz": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:context": "npm run build && node --test tests/context-manager.test.mjs tests/context-runtime.test.mjs",
    "smoke:context": "npm run build && node scripts/context-smoke.mjs",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@vscode/ripgrep": "^1.18.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "diff": "^9.0.0",
    "openai": "^6.45.0",
    "ora": "^8.0.1",
    "picomatch": "^4.0.5",
    "string-width": "^8.2.2",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/picomatch": "^4.0.3",
    "tsx": "^4.7.0"
  }
}
